#!/usr/bin/env bash
#MISE description="Rebuild the local package repository database"

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(realpath "${SCRIPT_DIR}/../../x86_64")"

echo "==> Rebuilding repo database..."

cd "${REPO_DIR}"

# Remove old db files so repo-add starts fresh
rm -f naur.{db,files}{,.tar.gz,.tar.gz.old}

# repo-add scans all .pkg.tar.zst and generates naur.db.tar.gz + naur.files.tar.gz
# The symlink names (naur.db, naur.files) are what pacman looks for.
shopt -s nullglob
packages=(./*.pkg.tar.zst)
if [ "${#packages[@]}" -eq 0 ]; then
    echo "ERROR: No package archives found in ${REPO_DIR}"
    exit 1
fi
repo-add "naur.db.tar.gz" "${packages[@]}"

echo "==> Repo database rebuilt."
echo "    ${#packages[@]} packages in ${REPO_DIR}"
